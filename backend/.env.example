# Copy to .env and adjust. Every setting maps to STEMFORGE_<NAME> (see stemforge/config.py).
# STEMFORGE_ENV=development
# Where the SQLite DB and private artifact storage live. On Windows keep this path short
# (or enable LongPathsEnabled): artifact keys add ~90 characters below it.
# STEMFORGE_DATA_DIR=C:/stemforge-data
# STEMFORGE_MODELS_DIR=./models
# STEMFORGE_DATABASE_URL=postgresql+psycopg://stemforge:stemforge@localhost:5432/stemforge
# STEMFORGE_STORAGE_BACKEND=local          # or s3
# STEMFORGE_S3_BUCKET=
# STEMFORGE_SIGNING_SECRET=                # required in production (HMAC for download links)
# STEMFORGE_API_TOKEN=                     # optional bearer token for all /api routes
# STEMFORGE_DEVICE=auto                    # auto | cuda | cpu
# STEMFORGE_DEMUCS_SEGMENT=                # e.g. 4 to cut VRAM use on small GPUs
# STEMFORGE_MAX_UPLOAD_MB=200
# STEMFORGE_MAX_DURATION_SECONDS=900
# STEMFORGE_RETENTION_DAYS=14
# STEMFORGE_STORAGE_QUOTA_GB=50
# STEMFORGE_WORKER_CONCURRENCY=1
